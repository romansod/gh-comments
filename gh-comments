  --arg unresolved "$UNRESOLVED" \
  --arg since "$SINCE" \
  --arg slr "$SLR" \
  --arg slr_author "$SLR_AUTHOR" \
  --arg latest "$LATEST" \
  --arg latest_author "$LATEST_AUTHOR" \
  --arg bots "$BOTS" \
  --arg hidden "$HIDDEN" \
  --arg merges "$MERGES" \
  --arg events "$EVENTS" \
  "$JQ_PROG"
