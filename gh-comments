   | if ($revs | length) == 0 and ($orphans | length) == 0 and ($held | length) == 0
     then (if $sliced and $topen > 0
           then "(no unresolved threads after the anchor; \($topen) open before it)"
           else "(no unresolved threads)" end)
     else
       ($revs[] | r_item($tmap; $TOC; true), (if $TOC then empty else "" end)),
       ($orphans | r_thread_block("threads with no parent review:"; $TOC)),
       ($held | r_thread_block("threads in filtered bot reviews:"; $TOC))
     end
 else
   (if ($items | length) == 0 then "(no timeline items)"
    else ($items[] | r_item($tmap; $TOC; false), (if $TOC then empty else "" end)) end),
   # Both blocks are already cut to the slice when there is one, and the
   # fallback (no review matched) is the full timeline, which shows both.
   ($orphans | r_thread_block("threads with no parent review:"; $TOC)),
   ($held | r_thread_block("threads in filtered bot reviews:"; $TOC))
 end)

end end
'

jq -rn \
  --slurpfile tl "$TL_FILE" \
  --slurpfile th "$TH_FILE" \
  --arg num "$NUM" \
  --arg rtype "$RTYPE" \
  --arg repo "$REPO" \
