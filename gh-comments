#!/usr/bin/env zsh

set -euo pipefail

# The release version. .claude-plugin/plugin.json and the release tag carry
# the same string; `make lint` checks that they agree.
VERSION=1.0.0

# The name this was invoked as prefixes every diagnostic, so a symlink named
# r-gh-comments reports as r-gh-comments. `:t` deliberately, not `:A` — `:A`
# resolves the symlink and would report the implementation's name instead of
# the one the user ran. `:r` drops an extension such a symlink may carry.
PROG=${0:t:r}
# gh sets GH_EXTENSION=1 when it runs an extension, so someone who typed
# `gh comments` is addressed as that — a bare `gh-comments` is usually not
# on their PATH.
[[ -n ${GH_EXTENSION:-} ]] && PROG="gh ${PROG#gh-}"
# The resource type is resolved from the API unless --pr / --issue pins it.
TYPE=auto
TYPE_PINNED_BY=""

usage() {
  local u
  u=$(cat <<'EOF'
Usage: @PROG@ [<number>] [flags]

Renders a GitHub pull request's or issue's discussion as compact,
grep-friendly text, with an aggregate-counts header line.

The resource type is resolved, never guessed: a repository numbers issues and
pull requests in one sequence, so <number> names exactly one of them and the
`issueOrPullRequest` GraphQL field says which. Pin it with --pr / --issue when
you want a wrong number to be an error rather than a different render.

  PRs    commits, reviews, inline comment threads (in place, with resolution
         state), issue comments, force-pushes.
  Issues the opening post, comments, and the events that change what the issue
         means — closed/reopened, cross-references, renames. Label, assignee
         and milestone churn is filtered out unless you ask for it.

With no number, uses the current branch's open PR (like `gh pr view`).

One paginated GraphQL fetch per surface; a thread with more replies than one
page carries an explicit [TRUNCATED: ...] marker instead of dropping them
silently. Rich-text HTML pastes are converted to markdown.

Flags:
  -R, --repo <owner/name>       Target repo (default: repo of the cwd)
  --pr, --issue                 Pin the resource type instead of resolving it
  --toc                         Skeleton only: one line per item, no bodies
  --since <iso-date>            Only items at/after this date (UTC): YYYY-MM-DD,
                                optionally with THH:MM[:SS][Z] (e.g. 2026-08-12)
  --bots                        Include bot comments and bot review bodies
                                (filtered by default). Threads are never
                                filtered: those of a filtered bot review render
                                under "threads in filtered bot reviews:".
                                Timeline events are never filtered by author —
                                a bot closing an issue is still why it closed.
  --hidden                      Show the bodies of hidden (minimized) comments.
                                By default a comment hidden as outdated, spam,
                                resolved, off-topic or duplicate renders as a
                                single marker line, e.g.
                                `comment [user date] (hidden: outdated)`, and
                                the counts line reports `(N hidden)`.

  Pull requests only:
  --unresolved                  Only reviews with open threads, and those threads
  --since-last-review[=<user>]  Only the last review (optionally by <user>)
                                and everything after it
  --latest[=<user>]             Only the most recent *substantive* review or
                                top-level comment (optionally by <user>) and
                                everything after it. Substantive: a review with
                                a body or inline threads, or a comment with a
                                body that is not hidden — so a bare approval
                                or a hidden comment is looked past as the
                                anchor, though it still shows when it comes
                                after the anchor; a bot is looked past and
                                not shown unless --bots. Exclusive with
                                --since-last-review, which anchors on the last
                                review object and ignores comments.
                                When either flag matches nothing, the TOC is
                                shown instead of the full timeline, under a
                                note saying so; with --unresolved or --since
                                that already-narrow view is shown as it is.
  --merges                      Include merge commits (filtered by default)

  Issues only:
  --events                      Include label / assignee / milestone events
                                (filtered by default; the counts line always
                                states how many were held back)

  --fixtures <tl.json> [<th.json>]
                                Render from saved GraphQL payloads instead of
                                fetching (testing/offline). Each file holds the
                                `gh api graphql --paginate ... | jq -s .` output
                                for the timeline / threads query. The threads
                                payload is required for a PR, meaningless for
                                an issue.
  -h, --help                    This help
  --version                     Print the version

Every item starts at column 0 with a stable prefix, so the output greps:
  grep '^review\|^commit'      PR timeline skeleton
  grep 'thread.*OPEN'          unaddressed inline threads
  grep '^xref\|^closed'        what happened to an issue
  grep -A 20 'B-M1'            one finding with its thread
  <!-- finding:ID --> markers are promoted onto thread header lines.

Typical agent flow: dump once, slice locally.
  @PROG@ 989 > gh989.txt && grep '^review' gh989.txt
EOF
  )
  print -r -- "${u//@PROG@/$PROG}"
}

NUM="" REPO="" TOC=0 UNRESOLVED=0 SINCE="" SLR=0 SLR_AUTHOR="" BOTS=0 MERGES=0 EVENTS=0 HIDDEN=0
# The arguments minus the pin, for the wrong-type hint: it suggests the same
# command again without --pr / --issue, so -R and the view flags survive.
typeset -a UNPINNED=("${(@)argv:#(--pr|--issue)}")
LATEST=0 LATEST_AUTHOR=""
FIXTURES_TL="" FIXTURES_TH=""
# need_value <flag> <form> <count> [<next>] — a flag that takes a value must
# have one, and it must not be the next flag. Under `set -u` a bare `-R` at
# the end of the line used to die with zsh's own "2: parameter not set",
# with a line number into the script.
need_value() {
  if (( $3 < 2 )) || [[ -z "${4:-}" || "${4:-}" == -* ]]; then
    echo "$PROG: $1 needs $2" >&2
    exit 1
  fi
}
while (( $# )); do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) print -r -- "gh-comments $VERSION"; exit 0 ;;
    -R|--repo) need_value "$1" "<owner/name>" $# "${2:-}"; REPO="$2"; shift 2 ;;
    --repo=*)  REPO="${1#*=}"; [[ -n "$REPO" ]] || need_value --repo "<owner/name>" 1; shift ;;
    --pr)      TYPE=pr; TYPE_PINNED_BY="--pr"; shift ;;
    --issue)   TYPE=issue; TYPE_PINNED_BY="--issue"; shift ;;
    --toc) TOC=1; shift ;;
    --unresolved) UNRESOLVED=1; shift ;;
    --since) need_value "$1" "<iso-date>" $# "${2:-}"; SINCE="$2"; shift 2 ;;
    --since=*) SINCE="${1#*=}"; [[ -n "$SINCE" ]] || need_value --since "<iso-date>" 1; shift ;;
    --since-last-review) SLR=1; shift ;;
    --since-last-review=*) SLR=1; SLR_AUTHOR="${1#*=}"; shift ;;
    --latest) LATEST=1; shift ;;
    --latest=*) LATEST=1; LATEST_AUTHOR="${1#*=}"; shift ;;
    --bots) BOTS=1; shift ;;
    --hidden) HIDDEN=1; shift ;;
    --merges) MERGES=1; shift ;;
    --events) EVENTS=1; shift ;;
    --fixtures)
      # The threads payload is optional: an issue has no review threads to
      # save. A second operand is taken only when it is a readable file that
      # is not itself a flag, so `--fixtures tl.json 21` still reads 21 as the
      # number rather than swallowing it.
      if (( $# < 2 )) || [[ ! -r "$2" ]]; then
        echo "$PROG: --fixtures needs a readable timeline JSON file (plus a threads file for a PR)" >&2
        exit 1
      fi
      FIXTURES_TL="$2"; shift 2
      if (( $# >= 1 )) && [[ "$1" != -* && -r "$1" ]]; then FIXTURES_TH="$1"; shift; fi
      ;;
    -*) echo "$PROG: unknown flag: $1" >&2; exit 1 ;;
    *)
      if [[ -n "$NUM" ]]; then echo "$PROG: unexpected argument: $1" >&2; exit 1; fi
      NUM="$1"; shift ;;
  esac
done

# --since is compared lexically against ISO timestamps, so anything that is
# not an ISO date gives a wrong answer with no error: `yesterday` sorts after
# every digit and matches nothing, `08/20/2026` sorts before `2` and matches
# everything. Date first, then an optional time; a
# date-only value already sorts before any timestamp on that day. The fields
# are bounded (month 01-12, day 01-31, hour 00-23, minute and second 00-59)
# because a mistyped `2026-13-01` otherwise passes and renders the same empty
# timeline a word did. Times are UTC, like the timestamps they are compared
# with; an offset such as `+02:00` is refused, since it cannot be compared
# lexically at all.
if [[ -n "$SINCE" && ! "$SINCE" =~ '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])(T([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?Z?)?$' ]]; then
  echo "$PROG: --since needs an ISO date, UTC (YYYY-MM-DD, optionally THH:MM[:SS][Z]); got: $SINCE" >&2
  exit 1
fi
# Every GitHub timestamp is `YYYY-MM-DDTHH:MM:SSZ`, and the comparison is a
# plain string `>=`, so an accepted value has to sort at or before every
# timestamp it means to include. Each accepted form is a prefix of that shape
# once a trailing Z is dropped; kept, `T18:00Z` sorts *after* `T18:00:00Z`
# (`Z` > `:`) and silently drops the whole minute it names.
SINCE=${SINCE%Z}
# Each of these picks the one item the timeline is sliced from; two answers
# to that question cannot both be honoured, so asking for both is an error
# rather than a silent preference.
if (( SLR && LATEST )); then
  echo "$PROG: --latest and --since-last-review are exclusive — each picks the item to slice from" >&2
  exit 1
fi

if [[ -n "$NUM" && "$NUM" != <-> ]]; then
  echo "$PROG: not a PR or issue number: $NUM" >&2
  usage >&2
  exit 1
fi
if [[ -z "$NUM" && -n "$FIXTURES_TL" ]]; then
  echo "$PROG: a number is required with --fixtures" >&2
  exit 1
fi
if [[ -z "$NUM" && "$TYPE" == issue ]]; then
  echo "$PROG: an issue number is required — there is no \"current branch's issue\"" >&2
  exit 1
fi

# The tools are checked after every refusal the parser can make on its own,
# so --help, --version and a usage error need neither, and before the first
# call to either — the branch lookup below is one — so a missing tool is a
# sentence naming it rather than zsh's "command not found" with a line
# number into this file. Both are named at once, so one rerun is enough. gh
# is needed only to fetch: a --fixtures render has no use for it, and the
# suite runs offline.
typeset -a MISSING=()
command -v jq >/dev/null 2>&1 || MISSING+=(jq)
if [[ -z "$FIXTURES_TL" ]] && ! command -v gh >/dev/null 2>&1; then
  MISSING+=("gh (the GitHub CLI)")
fi
if (( ${#MISSING} )); then
  echo "$PROG: needs ${(j: and :)MISSING} on PATH" >&2
  exit 1
fi

if [[ -z "$NUM" ]]; then
  NUM=$(gh pr view --json number --jq .number 2>/dev/null) || NUM=""
  if [[ -z "$NUM" ]]; then
    echo "$PROG: no number given and no PR found for the current branch" >&2
    exit 1
  fi
  # A branch resolves to a PR, so the type stops being an open question.
  TYPE=pr TYPE_PINNED_BY="the current branch's PR"
  echo "note: no number given — using the current branch's PR #$NUM" >&2
fi

if [[ -z "$REPO" ]]; then
  if [[ -n "$FIXTURES_TL" ]]; then
    REPO="fixtures/fixtures"
  else
    REPO=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || {
      echo "$PROG: not in a GitHub repo — pass -R <owner/name>" >&2
      exit 1
    }
  fi
fi
OWNER=${REPO%%/*}
NAME=${REPO##*/}

# ── Query construction ───────────────────────────────────────────────────────
#
# One query serves both resource types. `issueOrPullRequest` is what makes
# auto-detection safe rather than a guess: the union resolves the number the
# same way GitHub's own URL router does, and __typename reports the answer.
#
# The fragment for the type we did *not* ask for shrinks to `number title` —
# enough to name the mistake ("#43 is an issue, not a pull request: ...")
# without paying for a timeline that will never be rendered.

PR_STUB='number title'
ISSUE_STUB='number title'

# Timeline: commits, reviews, issue comments, force-pushes, in GitHub's own
# timeline order (which places rebased commits sanely, unlike raw commit dates).
#
# Two slots are substituted below rather than a second query being written out,
# so the shared fields cannot drift between the full and lean shapes.
PR_FULL='number title state isDraft baseRefName@PR_BODY@
      timelineItems(first:100,after:$endCursor,itemTypes:[@ITEM_TYPES@]){
        pageInfo{hasNextPage endCursor}
        nodes{
          __typename
          @COMMIT_FRAGMENT@
          ... on PullRequestReview{id author{login __typename} submittedAt state body}
          ... on IssueComment{author{login __typename} createdAt isMinimized minimizedReason@COMMENT_BODY@}
          ... on HeadRefForcePushedEvent{createdAt beforeCommit{abbreviatedOid} afterCommit{abbreviatedOid}}
        }
      }'

# Issue timeline. Every event type below is *fetched* unconditionally and
# filtered in the renderer, so the counts line can honestly report how many
# housekeeping events --events would have shown. Gating them in the query would
# make "(+6 housekeeping filtered)" unknowable, which is the failure mode this
# repo's bot/merge filtering already avoids.
#
# Deliberately not fetched: pinned/locked/transferred/duplicate/sub-issue
# events. They are rare and none of them change what the issue asks for.
ISSUE_FULL='number title state stateReason author{login __typename} createdAt body
      labels(first:20){totalCount nodes{name}}
      assignees(first:10){nodes{login}}
      timelineItems(first:100,after:$endCursor,itemTypes:[ISSUE_COMMENT,CLOSED_EVENT,REOPENED_EVENT,CROSS_REFERENCED_EVENT,RENAMED_TITLE_EVENT,LABELED_EVENT,UNLABELED_EVENT,ASSIGNED_EVENT,UNASSIGNED_EVENT,MILESTONED_EVENT,DEMILESTONED_EVENT]){
        pageInfo{hasNextPage endCursor}
        nodes{
          __typename
          ... on IssueComment{author{login __typename} createdAt isMinimized minimizedReason body}
          ... on ClosedEvent{actor{login __typename} createdAt stateReason}
          ... on ReopenedEvent{actor{login __typename} createdAt}
          ... on CrossReferencedEvent{actor{login __typename} createdAt willCloseTarget source{__typename ... on Issue{number title state repository{nameWithOwner}} ... on PullRequest{number title state repository{nameWithOwner}}}}
          ... on RenamedTitleEvent{actor{login __typename} createdAt previousTitle currentTitle}
          ... on LabeledEvent{actor{login __typename} createdAt label{name}}
          ... on UnlabeledEvent{actor{login __typename} createdAt label{name}}
          ... on AssignedEvent{actor{login __typename} createdAt assignee{__typename ... on User{login} ... on Bot{login} ... on Organization{login} ... on Mannequin{login}}}
          ... on UnassignedEvent{actor{login __typename} createdAt assignee{__typename ... on User{login} ... on Bot{login} ... on Organization{login} ... on Mannequin{login}}}
          ... on MilestonedEvent{actor{login __typename} createdAt milestoneTitle}
          ... on DemilestonedEvent{actor{login __typename} createdAt milestoneTitle}
        }
      }'

# --unresolved renders only reviews that still hold an open thread, plus the
# orphan threads under their own heading. No commit and no issue-comment body
# can reach that output — but the full query fetched them anyway: of 74,026 B
# slurped on a thread-heavy PR, 51,937 B was issue-comment bodies that mode
# never prints. The lean shape measures 5,186 B and renders
# byte-identically.
#
# The PR's own description goes the same way and for the same reason: it is
# rendered as a `body` item at the top of a normal dump, and --unresolved
# renders no such item, so fetching it there is pure waste. It is one field but
# not a small one — a PR description routinely runs longer than any single
# comment on the PR.
#
# The IssueComment *node* has to stay. The counts header reads
# "top-level comments: 12 (+2 bots filtered) (1 hidden)", which needs one
# node per comment, author.__typename to spot the bots and isMinimized to
# spot the hidden ones. Only the body goes.
#
# --toc is deliberately not part of the gate: `--toc --unresolved` renders the
# same reviews-and-threads subset, so it takes the lean query too. Bare --toc
# does not — it needs every body, for the previews and the findings scan.
#
# The flags that are gated out all need what the lean query drops: --since
# compares commit timestamps, and --since-last-review and --latest index into
# the full timeline to find the item to slice from (--latest also reads
# comment bodies to tell a substantive comment from an empty one).
#
# This buys wire bytes and wall-clock, *not* context tokens: stdout is
# identical either way, which is exactly what the byte-identity test asserts.
#
# The substituted values go through variables, not inline into ${x//p/r}: the
# commit fragment is full of braces, and a literal `}` there closes the
# parameter expansion early.
if (( UNRESOLVED )) && [[ -z "$SINCE" ]] && (( SLR == 0 )) && (( LATEST == 0 )); then
  TL_ITEM_TYPES='PULL_REQUEST_REVIEW,ISSUE_COMMENT,HEAD_REF_FORCE_PUSHED_EVENT'
  TL_COMMIT_FRAGMENT=''
  TL_COMMENT_BODY=''
  TL_PR_BODY=''
else
  TL_ITEM_TYPES='PULL_REQUEST_COMMIT,PULL_REQUEST_REVIEW,ISSUE_COMMENT,HEAD_REF_FORCE_PUSHED_EVENT'
  TL_COMMIT_FRAGMENT='... on PullRequestCommit{commit{abbreviatedOid messageHeadline committedDate parents(first:1){totalCount}}}'
  TL_COMMENT_BODY=' body'
  TL_PR_BODY=' author{login __typename} createdAt body'
fi
PR_FULL=${PR_FULL//@ITEM_TYPES@/$TL_ITEM_TYPES}
PR_FULL=${PR_FULL//@COMMIT_FRAGMENT@/$TL_COMMIT_FRAGMENT}
PR_FULL=${PR_FULL//@COMMENT_BODY@/$TL_COMMENT_BODY}
PR_FULL=${PR_FULL//@PR_BODY@/$TL_PR_BODY}

case "$TYPE" in
  pr)    PR_FRAGMENT=$PR_FULL;  ISSUE_FRAGMENT=$ISSUE_STUB ;;
  issue) PR_FRAGMENT=$PR_STUB;  ISSUE_FRAGMENT=$ISSUE_FULL ;;
  *)     PR_FRAGMENT=$PR_FULL;  ISSUE_FRAGMENT=$ISSUE_FULL ;;
esac

TL_QUERY='query($owner:String!,$name:String!,$num:Int!,$endCursor:String){
  repository(owner:$owner,name:$name){
    issueOrPullRequest(number:$num){
      __typename
      ... on PullRequest{@PR_FRAGMENT@}
      ... on Issue{@ISSUE_FRAGMENT@}
    }
  }
}'
TL_QUERY=${TL_QUERY//@PR_FRAGMENT@/$PR_FRAGMENT}
TL_QUERY=${TL_QUERY//@ISSUE_FRAGMENT@/$ISSUE_FRAGMENT}

# Inline threads: resolution state lives only here, not in the REST API.
# Issued only once the target is known to be a PR.
TH_QUERY='query($owner:String!,$name:String!,$num:Int!,$endCursor:String){
  repository(owner:$owner,name:$name){
    pullRequest(number:$num){
      reviewThreads(first:50,after:$endCursor){
        pageInfo{hasNextPage endCursor}
        nodes{
          isResolved isOutdated path line originalLine
          comments(first:50){totalCount pageInfo{hasNextPage} nodes{author{login __typename} createdAt isMinimized minimizedReason body pullRequestReview{id} originalCommit{abbreviatedOid}}}
        }
      }
    }
  }
}'

# Both payloads reach jq through files rather than argv. Passing them as
# --argjson blew macOS's 1 MB ARG_MAX on large PRs ("argument list too long:
# jq", exit 127, zero output) — and did so *after* both fetches had been paid
# for. --slurpfile slurps a stream of JSON values into an array, which is
# exactly what `jq -s .` produced, so the jq program needs no changes.
# Cleanup needs all three traps, and the signal ones have to exit. A single
# `trap ... EXIT INT TERM` deletes the payloads and then *keeps running*, since
# zsh resumes execution after a non-exiting signal handler — the script limps
# on into the error branch and reads files that no longer exist. But EXIT alone
# does not fire on SIGTERM at all, so it leaks all three files. Handlers that
# exit get both: the exit runs the EXIT trap, and the script actually stops.
TL_FILE=$(mktemp) TH_FILE=$(mktemp) GH_ERR=""
trap 'rm -f "$TL_FILE" "$TH_FILE" ${GH_ERR:+"$GH_ERR"}' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# resolved_type <file> — what the timeline payload actually holds. The union's
# __typename is authoritative when present; the wrapping field name is the
# fallback, which is what keeps payloads captured before `issueOrPullRequest`
# (every fixture in tests/fixtures/pr-comments/) readable.
resolved_type() {
  # `-n` + `input` reads exactly the first document. Both payload shapes reach
  # here as a *stream* of pages, so a bare filter would answer once per page
  # and the caller would compare a multi-line string against "pr".
  jq -rn 'input | (if type == "array" then .[0] else . end)
         | (.data.repository // {})
         | if (.issueOrPullRequest // null) != null then
             (.issueOrPullRequest.__typename
              | if . == "PullRequest" then "pr" elif . == "Issue" then "issue" else "unknown" end)
           elif (.pullRequest // null) != null then "pr"
           elif (.issue // null) != null then "issue"
           else "none" end' "$1" 2>/dev/null || print -r -- unknown
}

# target_title <file> — the title of whatever the payload holds, for the
# wrong-type diagnosis.
target_title() {
  jq -rn 'input | (if type == "array" then .[0] else . end)
         | (.data.repository // {})
         | ((.issueOrPullRequest // .pullRequest // .issue // {}).title // "")' "$1" 2>/dev/null || true
}

if [[ -n "$FIXTURES_TL" ]]; then
  # Fixtures hold the documented `jq -s .` array form; unwrap one level into
  # the value stream --slurpfile expects (a bare stream is accepted too).
  jq -c 'if type == "array" then .[] else . end' "$FIXTURES_TL" > "$TL_FILE"
  if [[ -n "$FIXTURES_TH" ]]; then
    jq -c 'if type == "array" then .[] else . end' "$FIXTURES_TH" > "$TH_FILE"
  fi
else
  # The two fetches stay sequential and in the foreground. Overlapping them is
  # worth ~30% of a ~1.9 s run and was tried here, but it
  # buys wall-clock rather than context tokens — which was never what the issue
  # was about — and it moves both calls out from under the shell's own process
  # management. Two defects came with it, both caught in review:
  #
  #   - A shell started without job control gives background children SIGINT
  #     set to SIG_IGN, so Ctrl-C stopped this script and left two gh processes
  #     paginating the API, writing into files the EXIT trap had unlinked.
  #   - The threads call then ran unconditionally, so a bad number printed
  #     gh's raw "Could not resolve" ahead of the curated not-found diagnosis.
  #
  # Both were fixable and were fixed, but the cost was a signal handler and a
  # second stderr capture guarding a latency win nobody asked for. Left
  # sequential deliberately: the win is wall-clock, not context, and not
  # worth the handlers it needs.
  GH_ERR=$(mktemp)
  if ! gh api graphql --paginate -F owner="$OWNER" -F name="$NAME" -F num="$NUM" -f query="$TL_QUERY" > "$TL_FILE" 2>"$GH_ERR"; then
    # gh may report the failure on either stream, so both are searched.
    if ! grep -q "Could not resolve" "$GH_ERR" "$TL_FILE"; then
      echo "$PROG: gh error:" >&2
      # gh writes a one-line summary to stderr *and* the full errors[] body
      # (type/path/locations) to stdout; show both, since either can carry the
      # detail the other lacks. The JSON body arrives with no trailing newline,
      # hence the tail -c1 check — $(...) strips a trailing newline, so an empty
      # result means the file already ended in one.
      for f in "$GH_ERR" "$TL_FILE"; do
        [[ -s "$f" ]] || continue
        cat "$f" >&2
        if [[ -n "$(tail -c1 "$f")" ]]; then echo >&2; fi
      done
      exit 1
    fi
    # `issueOrPullRequest` resolves both sequences, so a number that fails to
    # resolve is not a PR *or* an issue — it does not exist in this repo.
    echo "$PROG: #$NUM not found in $REPO" >&2
    # Diagnose, don't silently switch targets: N is often the issue number
    # embedded in the branch name, while the branch's PR is something else.
    BRANCH_PR=$(gh pr view --json number,title --jq '"#\(.number): \(.title)"' 2>/dev/null) || BRANCH_PR=""
    [[ -n "$BRANCH_PR" ]] && echo "  the current branch's PR is $BRANCH_PR — rerun with that number" >&2
    exit 1
  fi
fi

RTYPE=$(resolved_type "$TL_FILE")
if [[ "$RTYPE" == none || "$RTYPE" == unknown ]]; then
  echo "$PROG: #$NUM not found in $REPO" >&2
  exit 1
fi

# A pinned type that does not match is an error, never a silent switch: the
# whole point of `gh-comments 43 --pr` is that 43 had better be a PR.
if [[ "$TYPE" != auto && "$TYPE" != "$RTYPE" ]]; then
  TITLE=$(target_title "$TL_FILE")
  typeset -A ARTICLE=(pr "a pull request" issue "an issue")
  echo "$PROG: #$NUM is ${ARTICLE[$RTYPE]}, not ${ARTICLE[$TYPE]}${TITLE:+: \"$TITLE\"}" >&2
  echo "  the type was pinned by $TYPE_PINNED_BY — rerun as: $PROG ${(j: :)${(@q-)UNPINNED}}" >&2
  exit 1
fi

# Flags that only one resource type can honour. Silently ignoring them would
# report a filtered view as a complete one.
if [[ "$RTYPE" == issue ]]; then
  typeset -a BAD=()
  (( UNRESOLVED )) && BAD+=(--unresolved)
  (( SLR )) && BAD+=(--since-last-review)
  (( LATEST )) && BAD+=(--latest)
  (( MERGES )) && BAD+=(--merges)
  if (( ${#BAD} )); then
